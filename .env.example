# Obsergent example agent: which language model to use. Copy to .env (cp .env.example .env) and edit.
# .env is git-ignored: put your API keys there, never in code. Variables already set in your shell win over this file.
#
#   LLM_PROVIDER  who serves the model        LLM_MODEL  the model's name at that provider
#   LLM_API_KEY   optional, overrides the provider's usual key variable below
#   LLM_BASE_URL  optional, another address (any OpenAI-compatible server)
#   LLM_TEMPERATURE  0 = same answer every time (default)
# The model must support tool calling (function calling) for the agent to use the MCP tools.

# ---- 1. Local, free, open source: Ollama (ollama pull qwen2.5:7b) ----
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
# OLLAMA_HOST=http://localhost:11434

# ---- 2. Hosted services: uncomment ONE block (and comment out block 1) ----
# OpenAI                                   (pip install langchain-openai)
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# Anthropic                                (pip install langchain-anthropic)
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini                            (pip install langchain-google-genai)
# LLM_PROVIDER=google
# LLM_MODEL=gemini-2.0-flash
# GOOGLE_API_KEY=...

# Groq (open models, very fast)
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=gsk_...

# OpenRouter (hundreds of models behind one key)
# LLM_PROVIDER=openrouter
# LLM_MODEL=openai/gpt-4o-mini
# OPENROUTER_API_KEY=sk-or-...

# Hugging Face (Inference Providers router)
# LLM_PROVIDER=huggingface
# LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
# HF_TOKEN=hf_...

# Others with the same one-block shape: together, fireworks, deepseek, mistral, xai, perplexity
# LLM_PROVIDER=together
# LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
# TOGETHER_API_KEY=...

# ---- 3. Your own server that speaks the OpenAI API (vLLM, llama.cpp, LM Studio, LiteLLM, text-generation-inference) ----
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=your-model-name
# LLM_API_KEY=anything-if-the-server-needs-none
# (LM Studio: LLM_PROVIDER=lmstudio, its default address http://localhost:1234/v1 is built in)

# ---- 4. Any other LangChain provider (bedrock, cohere, azure_openai, ...): install langchain-<provider> and use its name ----
# LLM_PROVIDER=bedrock
# LLM_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
