# Copy this file to ".env", fill in your keys, then load it into your terminal:
#     cp .env.example .env
#     set -a; source .env; set +a
# (".env" is git-ignored, so your secret key is never committed.)

# Option A - Langfuse Cloud (free Hobby plan): create a project at https://cloud.langfuse.com
#            then use  LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Option B - self-hosted Langfuse on your laptop (free): see README, then use http://localhost:3000

# Project keys: Langfuse UI -> your project -> Settings -> API Keys -> "Create new API keys"
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# Where your Langfuse lives (this value is for Option B, self-hosted)
LANGFUSE_BASE_URL=http://localhost:3000
